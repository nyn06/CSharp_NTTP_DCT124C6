@model IReadOnlyList<MetropolitanCoffee.Core.Models.Product>
@{ ViewData["Title"] = "Metropolitan Coffee"; }
<!-- ===== HERO SECTION ===== -->
<section id="hero" class="hero text-center text-light">
  <div class="container py-5 hero-content">
    <img src="~/assets/img/MetropolitanCafeLogo.png" width="160" height="160" class="d-block mx-auto mb-4 rounded-circle" alt="logo">
    <h1>Metropolitan Coffee</h1>
    <h2>Stand Loud - Stand Proud</h2>
    <p class="lead text-secondary mt-3">Modern European aesthetics. Crafted coffees, fine teas, ice-blended treats & elegant desserts.</p>
    <div class="mt-3">
      <a href="@Url.Action("Menu", "Home")" class="btn btn-light btn-lg px-4 me-2">Explore Menu</a>
      <a href="#why" class="btn btn-outline-light btn-lg px-4">Our Story</a>
    </div>
  </div>
</section>

<style>
.hero {
  min-height: 70vh;
  display: grid;
  place-items: center;
  text-align: center;
  background: radial-gradient(70% 50% at 50% 50%, #fff8f2 0%, #fff9f5 100%);
  position: relative;
  overflow: hidden;
}
.hero-bg, .hero-bg-next {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  opacity: 0;
  transition: opacity 1s ease-in-out;
  z-index: 1;
}
.hero-content {
  position: relative;
  z-index: 2;
  transition: opacity 0.8s ease-in-out;
}

/* ===== WELCOME STYLE ===== */
.welcome-section{
  text-align:center;
  padding:70px 20px;
  background:#f3ede6;
}
.welcome-section h2{
  font-size:42px;
  font-weight:600;
  color:#4a403a;
  margin-bottom:15px;
}
.welcome-section p{
  font-size:18px;
  color:#6b625c;
}
</style>

<script>
// ===== HERO SLIDESHOW =====
document.addEventListener("DOMContentLoaded", () => {
  const hero = document.getElementById("hero");
  if (!hero) return;

  const content = hero.querySelector(".hero-content");
  const bg1 = document.createElement("div");
  const bg2 = document.createElement("div");
  bg1.className = "hero-bg";
  bg2.className = "hero-bg-next";
  hero.appendChild(bg1);
  hero.appendChild(bg2);

  const slides = ["/assets/img/bg1.jpg","/assets/img/bg2.jpg","/assets/img/bg3.jpg"];
  let index = 0;
  let showingFirst = true;
  const interval = 1800;

  function changeSlide() {
    const nextImg = slides[index];
    const currentLayer = showingFirst ? bg1 : bg2;
    const nextLayer = showingFirst ? bg2 : bg1;

    if (content) content.style.opacity = 0;

    nextLayer.style.backgroundImage = `url('${nextImg}')`;
    nextLayer.style.opacity = 1;
    currentLayer.style.opacity = 0;

    showingFirst = !showingFirst;
    index++;

    if (index >= slides.length) {
      setTimeout(() => {
        bg1.style.opacity = 0;
        bg2.style.opacity = 0;
        if (content) content.style.opacity = 1;
        index = 0;
      }, interval);
    }
  }

  setInterval(changeSlide, interval);
});
</script>

<!-- ===== FEATURED ===== -->
@if (TempData["CartError"] is string cartError) { <div class="alert alert-danger container">@cartError</div> }
<section class="container py-5">
  <p class="section-title mb-2">Signature Picks</p>
  <div class="row g-4" id="homePicks">
    @foreach (var product in Model) { @await Html.PartialAsync("_ProductCard", product) }
    @if (Model.Count == 0) { <p class="text-muted">No products available right now.</p> }
  </div>
</section>
@await Html.PartialAsync("_OptionModal")

<!-- ===== WHY CHOOSE US ===== -->
<section id="why" class="container pb-5">
  <p class="section-title mb-2">Why Choose Us</p>
  <div class="row g-4">
    <div class="col-md"><div class="card p-4 h-100"><h5>Minimal but warm</h5><p class="mb-0">Our clean, monochrome palette highlights every cup and dessert beautifully. Simple, elegant, and full of warmth.</p></div></div>
    <div class="col-md"><div class="card p-4 h-100"><h5>Fast ordering</h5><p class="mb-0">Add your favorites to the cart, review, and check out in seconds. We make your ordering experience smooth, fast, and absolutely hassle-free.</p></div></div>
    <div class="col-md"><div class="card p-4 h-100"><h5>Premium products</h5><p class="mb-0">We carefully select the finest coffee beans, pure tea leaves, and fresh ingredients to ensure every drink and dessert meets the highest standards of flavor and freshness. Each product is crafted with passion and precision to delight your senses.</p></div></div>
  </div>
</section>

<!-- ===== WELCOME SECTION ===== -->
<section class="welcome-section">
  <h2>Welcome to Metropolitan Coffee!</h2>
  <p>Enjoy your time with us â˜•</p>
</section>





