@model IReadOnlyList<MetropolitanCoffee.Core.Models.CustomerOrder>
@{ ViewData["Title"] = "Orders | Metropolitan Coffee"; }
<main class="container py-5"><p class="section-title mb-1">Your Purchases</p><h2>Order History</h2><div class="card p-4 mt-3">
@if (TempData["OrderNotice"] is string notice) { <div class="alert alert-success" role="status">@notice</div> }
@if (TempData["OrderError"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
@if (Model.Count == 0) { <p class="text-muted">You haven't placed any orders yet.</p> }
@foreach (var order in Model)
{
  <div class="border-bottom py-3"><h5>Order ID: @order.Id</h5>
    <p><strong>Date:</strong> @order.CreatedAt.ToString("MM/dd/yyyy HH:mm")</p>
    <p><strong>Total:</strong> $@order.Total.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</p>
    <p><strong>Status:</strong> <span class="badge @(order.Status switch { "confirmed" => "bg-info", "shipping" => "bg-primary", "delivered" => "bg-success", "cancelled" => "bg-danger", _ => "bg-secondary" })">@order.Status</span></p>
    <p><strong>Payment:</strong> @order.PaymentMethod</p>
    <p><strong>Address:</strong> @order.ShipAddress, @order.ShipWard, @order.ShipCity</p>
    <div class="d-flex flex-wrap gap-2">
      <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-dark">View details</a>
      @if (order.Status == "pending")
      {
        <a asp-action="Details" asp-route-id="@order.Id" asp-fragment="edit-address" class="btn btn-sm btn-edit">Edit Address</a>
        <form asp-action="Cancel" asp-route-id="@order.Id" method="post" onsubmit="return confirm('Are you sure you want to cancel this order?')">
          @Html.AntiForgeryToken()
          <button type="submit" class="btn btn-sm btn-cancel">Cancel Order</button>
        </form>
      }
    </div>
  </div>
}
</div></main>
