@model MetropolitanCoffee.Core.Models.Product
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{
    var imageUrl = Url.Content(ProductImageResolver.Resolve(Model, HostEnvironment.WebRootPath));
}
<div class="col-6 col-md-4 col-lg-3 catalog-product" data-name="@Model.Name">
  <div class="card h-100 shadow-sm border-0">
    <img src="@imageUrl" class="card-img-top rounded" alt="@Model.Name" loading="lazy" height="180"
         onerror="this.onerror=null;this.src='@Url.Content("~/assets/img/MetropolitanCafeLogo.png")';">
    <div class="card-body d-flex flex-column">
      <span class="badge badge-cat align-self-start mb-2 text-uppercase">@Model.CategoryName.ToLowerInvariant()</span>
      <h6 class="card-title flex-grow-1">@Model.Name</h6>
      <p class="small text-muted mb-2">@Model.ShortDescription</p>
      <div class="d-flex justify-content-between align-items-center">
        <span class="price">$@Model.SellPrice.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)</span>
        <div class="btn-group">
          <a href="@Url.Action("Product", "Home", new { id = Model.Id })" class="btn btn-sm btn-view">View</a>
          @if (Model.IsSoldOut)
          {
            <button type="button" class="btn btn-sm btn-secondary disabled" disabled>Sold Out</button>
          }
          else
          {
            <button type="button" class="btn btn-sm btn-add" data-bs-toggle="modal" data-bs-target="#optionModal"
                    data-product-id="@Model.Id" data-has-size="@Model.HasSize.ToString().ToLowerInvariant()"
                    data-has-ice="@Model.HasIce.ToString().ToLowerInvariant()" data-has-sugar="@Model.HasSugar.ToString().ToLowerInvariant()">Add</button>
          }
        </div>
      </div>
    </div>
  </div>
</div>



