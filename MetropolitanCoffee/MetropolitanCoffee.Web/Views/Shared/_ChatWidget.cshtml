<style>
/* --- Nút mở chat --- */
.mc-chat-section {
  padding: 0;
  height: 0;
}
.mc-chat-shell {
  position: static;
  height: 0;
  min-height: 0;
}
#mc-chat-btn {
  position: fixed;
  bottom: 30px;
  left: 30px;
  width: 58px;
  height: 58px;
  border-radius: 50%;
  background: #827d79;
  border: none;
  cursor: pointer;
  box-shadow: 0 4px 18px rgba(90, 87, 86, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  transition: transform .2s, box-shadow .2s, bottom .3s ease;
}
#mc-chat-btn:hover { transform: scale(1.08); box-shadow: 0 6px 24px rgba(59, 56, 55, 0.55); }
#mc-chat-btn svg   { width:26px; height:26px; fill:#fff; }
#mc-badge {
  position: absolute;
  top: -4px; right: -4px;
  background: #e05b2e;
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  border-radius: 50%;
  width: 19px; height: 19px;
  display: flex; align-items: center; justify-content: center;
  display: none;
}

/* --- Cửa sổ chat --- */
#mc-chat-box {
  position: fixed;
  bottom: 100px;
  left: 30px;
  width: 360px;
  max-height: 540px;
  background: #fff;
  border-radius: 18px;
  box-shadow: 0 12px 48px rgba(0,0,0,.18);
  display: flex;
  flex-direction: column;
  z-index: 9998;
  overflow: hidden;
  transform: scale(.92) translateY(20px);
  opacity: 0;
  pointer-events: none;
  transition: transform .25s cubic-bezier(.34,1.56,.64,1), opacity .2s, bottom .3s ease;
}
#mc-chat-box.open {
  transform: scale(1) translateY(0);
  opacity: 1;
  pointer-events: all;
}

/* Header */
#mc-chat-header {
  background: #827d79;
  color: #fff;
  padding: 14px 16px;
  display: flex;
  align-items: center;
  gap: 11px;
}
#mc-chat-header .mc-avatar {
  width: 38px; height: 38px;
  border-radius: 50%;
  background: rgba(255,255,255,.2);
  display: flex; align-items: center; justify-content: center;
  font-size: 20px;
  flex-shrink: 0;
}
#mc-chat-header .mc-info { flex: 1; }
#mc-chat-header .mc-name { font-weight: 700; font-size: 14px; }
#mc-chat-header .mc-status {
  font-size: 11px;
  opacity: .8;
  display: flex; align-items: center; gap: 5px;
}
#mc-chat-header .mc-dot {
  width: 7px; height: 7px;
  background: #5ddb8a;
  border-radius: 50%;
  display: inline-block;
}
#mc-close-btn {
  background: none; border: none;
  color: rgba(255,255,255,.75);
  cursor: pointer; font-size: 22px;
  line-height: 1; padding: 0;
  transition: color .15s;
}
#mc-close-btn:hover { color: #fff; }

/* Language toggle */
#mc-lang-toggle {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,.15);
  border-radius: 20px;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,.3);
  flex-shrink: 0;
}
.mc-lang-btn {
  background: none;
  border: none;
  color: rgba(255,255,255,.65);
  font-size: 11px;
  font-weight: 600;
  padding: 3px 9px;
  cursor: pointer;
  transition: background .15s, color .15s;
  letter-spacing: .3px;
}
.mc-lang-btn.active {
  background: rgba(255,255,255,.28);
  color: #fff;
}
.mc-lang-btn:hover:not(.active) {
  background: rgba(255,255,255,.12);
  color: rgba(255,255,255,.9);
}

/* Vùng tin nhắn */
#mc-messages {
  flex: 1;
  overflow-y: auto;
  padding: 14px 14px 6px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  background: #faf7f4;
  scroll-behavior: smooth;
}
#mc-messages::-webkit-scrollbar { width: 4px; }
#mc-messages::-webkit-scrollbar-thumb { background: #ddd; border-radius: 4px; }

/* Bubble */
.mc-bubble {
  max-width: 82%;
  padding: 9px 13px;
  border-radius: 16px;
  font-size: 13.5px;
  line-height: 1.55;
  word-break: break-word;
  animation: mcFadeIn .22s ease;
}
@@keyframes mcFadeIn { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:none; } }
.mc-bubble.bot {
  background: #fff;
  color: #333;
  border: 1px solid #ece5de;
  border-bottom-left-radius: 4px;
  align-self: flex-start;
}
.mc-bubble.user {
  background: #827d79;
  color: #fff;
  border-bottom-right-radius: 4px;
  align-self: flex-end;
}
.mc-bubble a { color: #a19c98; }
.mc-bubble.bot a { color: #827d79; font-weight: 600; }

/* Lang switch notice bubble */
.mc-bubble.lang-notice {
  background: #fff8f0;
  border: 1px dashed #d4a96a;
  color: #a19c98;
  font-size: 12px;
  align-self: center;
  max-width: 90%;
  text-align: center;
  padding: 6px 12px;
}

/* Typing indicator */
#mc-typing {
  display: none;
  align-self: flex-start;
  background: #fff;
  border: 1px solid #ece5de;
  border-radius: 16px;
  border-bottom-left-radius: 4px;
  padding: 10px 16px;
}
#mc-typing span {
  display: inline-block;
  width: 7px; height: 7px;
  background: #bbb;
  border-radius: 50%;
  margin: 0 2px;
  animation: mcBounce .9s infinite;
}
#mc-typing span:nth-child(2) { animation-delay: .18s; }
#mc-typing span:nth-child(3) { animation-delay: .36s; }
@@keyframes mcBounce {
  0%,80%,100% { transform: translateY(0); }
  40%         { transform: translateY(-6px); }
}

/* Quick replies */
#mc-quick-replies {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  padding: 8px 14px 4px;
  background: #faf7f4;
}
.mc-quick-btn {
  background: #fff;
  border: 1px solid #d4c5b8;
  color: #827d79;
  font-size: 12px;
  padding: 5px 11px;
  border-radius: 20px;
  cursor: pointer;
  transition: background .15s, border-color .15s;
  white-space: nowrap;
}
.mc-quick-btn:hover { background: #f3ebe4; border-color: #827d79; }

/* Input */
#mc-input-area {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px 12px;
  background: #fff;
  border-top: 1px solid #ece5de;
}
#mc-input {
  flex: 1;
  border: 1px solid #ddd;
  border-radius: 24px;
  padding: 9px 14px;
  font-size: 13.5px;
  outline: none;
  background: #faf7f4;
  transition: border-color .15s;
}
#mc-input:focus { border-color: #827d79; background: #fff; }
#mc-send-btn {
  width: 38px; height: 38px;
  border-radius: 50%;
  background: #827d79;
  border: none;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  transition: background .15s, transform .1s;
}
#mc-send-btn:hover   { background: #a19c98; }
#mc-send-btn:active  { transform: scale(.93); }
#mc-send-btn svg     { width:17px; height:17px; fill:#fff; }

@@media (max-width: 480px) {
  .mc-chat-section,
  .mc-chat-shell {
    height: 0;
  }
  #mc-chat-box { width: calc(100vw - 24px); left: 12px; bottom: 90px; }
  #mc-chat-btn { bottom: 18px; left: 18px; }
}

/* Chỉ ẩn bản duplicate nằm BÊN TRONG .mc-chat-section (nếu có) */
.mc-chat-section #mc-chat-btn,
.mc-chat-section #mc-chat-box {
  display: none !important;
}
</style>
<button id="mc-chat-btn" aria-label="Open chat support" title="Chat with us">
  <svg viewBox="0 0 24 24"><path d="M20 2H4a2 2 0 0 0-2 2v18l4-4h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2zm0 14H5.17L4 17.17V4h16v12z"/></svg>
  <span id="mc-badge">1</span>
</button>

<!-- ── CỬA SỔ CHAT ── -->
<div id="mc-chat-box" role="dialog" aria-label="Chat support window">

  <!-- Header -->
  <div id="mc-chat-header">
    <div class="mc-avatar">☕</div>
    <div class="mc-info">
      <div class="mc-name">Metropolitan Coffee</div>
      <div class="mc-status" id="mc-status-text">
        <span class="mc-dot"></span> <span id="mc-status-label">Online</span>
      </div>
    </div>
    <!-- Language Toggle -->
    <div id="mc-lang-toggle" title="Switch language / Đổi ngôn ngữ">
      <button class="mc-lang-btn active" data-lang="en">EN</button>
      <button class="mc-lang-btn" data-lang="vi">VI</button>
    </div>
    <button id="mc-close-btn" aria-label="Close chat">×</button>
  </div>

  <!-- Tin nhắn -->
  <div id="mc-messages">
    <!-- Tin nhắn chào mặc định (English) -->
    <div class="mc-bubble bot" id="mc-welcome-msg">
      Hello! ☕ Welcome to <b>Metropolitan Coffee</b>!<br>
      How can I help you today?
    </div>
  </div>

  <!-- Typing -->
  <div id="mc-typing"><span></span><span></span><span></span></div>

  <!-- Quick replies -->
  <div id="mc-quick-replies"></div>

  <!-- Input -->
  <div id="mc-input-area">
    <input id="mc-input" type="text" placeholder="Type your question..." autocomplete="off" maxlength="200"/>
    <button id="mc-send-btn" aria-label="Send">
      <svg viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
    </button>
  </div>
</div>

<!-- ── CHATBOT SCRIPT ── -->

<script>
(() => {
  const btn = document.getElementById('mc-chat-btn');
  const box = document.getElementById('mc-chat-box');
  document.getElementById('mc-close-btn').addEventListener('click', () => box.classList.remove('open'));
  btn.addEventListener('click', () => box.classList.toggle('open'));
  document.getElementById('mc-send-btn').addEventListener('click', () => {
    const input = document.getElementById('mc-input');
    if (!input.value.trim()) return;
    const note = document.createElement('div');
    note.className = 'mc-bubble bot';
    note.textContent = 'Chatbot s? ho?t ??ng sau khi k?t n?i backend.';
    document.getElementById('mc-messages').appendChild(note);
    input.value = '';
  });
})();
</script>
