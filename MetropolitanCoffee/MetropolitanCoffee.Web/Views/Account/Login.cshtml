@model LoginViewModel
@{
    Layout = null;
}
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Login | Metropolitan Coffee</title><link href="~/assets/css/bootstrap.min.css" rel="stylesheet"><link href="~/assets/css/style.css" rel="stylesheet">
<style>
body{min-height:100vh;margin:0;background:radial-gradient(circle at center,rgba(0,0,0,.35),rgba(0,0,0,.8)),url('/assets/img/bg2.jpg') center/cover no-repeat fixed;display:flex;align-items:center;justify-content:center;color:white;font-family:Poppins,sans-serif}
.auth-card{background:rgba(255,255,255,.1);backdrop-filter:blur(15px);border:1px solid rgba(255,255,255,.2);border-radius:24px;box-shadow:0 10px 40px rgba(0,0,0,.5);width:400px;max-width:95vw;padding:50px 40px;text-align:center}
.auth-card img{width:120px;height:120px;border:10px solid white;border-radius:50%;object-fit:cover;margin-bottom:20px}
.auth-card h2{font-family:'Playfair Display',serif;color:#f4e6d7;margin-bottom:25px}.form-control{background:rgba(255,255,255,.9);border:0;border-radius:10px;padding:12px 14px}
.btn-dark{background:linear-gradient(135deg,#4a403a,#d6b37f);border:0;border-radius:50px;padding:10px}
</style></head><body><div class="auth-card">
<a asp-controller="Home" asp-action="Index"><img src="~/assets/img/MetropolitanCafeLogo.png" alt="Logo"></a>
<h2>Welcome Back</h2>
@if (TempData["AccountNotice"] is string notice) { <div class="alert alert-success">@notice</div> }
<form asp-action="Login" method="post">
  @Html.AntiForgeryToken()
  <input asp-for="ReturnUrl" type="hidden">
  <input asp-for="Username" class="form-control mb-3" placeholder="Username" autocomplete="username" required>
  <input asp-for="Password" class="form-control mb-3" type="password" placeholder="Password" autocomplete="current-password" required>
  <div asp-validation-summary="ModelOnly" class="alert alert-danger text-start"></div>
  <button class="btn btn-dark w-100" type="submit">Login</button>
</form>
<p class="mt-3 mb-0">Don't have an account? <a asp-action="Register" class="text-white">Register here</a></p>
</div></body></html>
