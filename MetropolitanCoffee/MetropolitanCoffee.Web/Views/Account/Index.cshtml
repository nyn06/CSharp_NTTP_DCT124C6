@model MetropolitanCoffee.Core.Models.CustomerProfile
@inject IWebHostEnvironment WebEnvironment
@{ ViewData["Title"] = "My Account | Metropolitan Coffee"; }
<main class="container py-5" style="max-width:900px">
  <p class="section-title mb-1">Your Profile</p><h2 class="mb-4">My Account</h2>
  @if (TempData["AccountNotice"] is string notice) { <div class="alert alert-success" role="status">@notice</div> }
  @if (TempData["AccountError"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
  <div class="row g-4">
    <div class="col-lg-7">
      <section class="card shadow-sm p-4 h-100">
        <div class="text-center mb-4">
          <img id="profileAvatar" src="@Url.Content(CustomerAvatarResolver.Resolve(Model.Avatar, WebEnvironment.WebRootPath))" alt="Profile avatar" width="120" height="120" class="rounded-circle border" style="object-fit:cover">
          <form asp-action="UpdateAvatar" method="post" enctype="multipart/form-data" class="mt-3">
            @Html.AntiForgeryToken()
            <label for="avatar" class="form-label d-block">Change Photo</label>
            <input id="avatar" name="avatar" type="file" accept="image/jpeg,image/png,image/gif,image/webp" class="form-control form-control-sm mx-auto" style="max-width:340px" required>
            <small class="d-block text-muted mt-1">JPG, PNG, GIF or WEBP. Maximum 5 MB.</small>
            <button type="submit" class="btn btn-sm btn-outline-dark mt-2">Save Photo</button>
          </form>
        </div>
        <h5>Personal Information</h5><hr>
        <dl class="row mb-0">
          <dt class="col-sm-4">Username</dt><dd class="col-sm-8 text-break">@Model.Username</dd>
          <dt class="col-sm-4">First Name</dt><dd class="col-sm-8 text-break">@Model.FirstName</dd>
          <dt class="col-sm-4">Last Name</dt><dd class="col-sm-8 text-break">@Model.LastName</dd>
          <dt class="col-sm-4">Email</dt><dd class="col-sm-8 text-break">@Model.Email</dd>
          <dt class="col-sm-4">Phone Number</dt><dd class="col-sm-8">@Model.Phone</dd>
          <dt class="col-sm-4">Account Status</dt><dd class="col-sm-8"><span class="badge bg-success">@Model.Status</span></dd>
        </dl>
        <div class="d-flex flex-wrap gap-2 mt-3">
          <a asp-action="EditProfile" class="btn btn-edit">Edit Profile</a>
          <a asp-action="ChangePassword" class="btn btn-outline-dark">Change Password</a>
        </div>
      </section>
    </div>
    <div class="col-lg-5">
      <section class="card shadow-sm p-4 mb-4">
        <h5>Saved Delivery Address</h5><hr>
        <p class="mb-1 text-break">@Model.Address</p>
        <p class="mb-1 text-break">@Model.Ward</p>
        <p class="mb-3 text-break">@Model.City</p>
        <a asp-action="EditProfile" class="btn btn-sm btn-edit align-self-start">Edit Address</a>
      </section>
      <section class="card shadow-sm p-4">
        <h5>Your Orders</h5><p class="text-muted">View your purchases, delivery details and order status.</p>
        <a asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-outline-dark align-self-start">Order History</a>
      </section>
    </div>
  </div>
</main>
