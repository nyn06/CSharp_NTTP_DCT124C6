@model MetropolitanCoffee.Web.Models.ChangePasswordViewModel
@{ ViewData["Title"] = "Change Password | Metropolitan Coffee"; }
<main class="container py-5" style="max-width:600px">
  <a asp-action="Index" class="btn btn-sm btn-outline-dark mb-3">← My Account</a>
  <h2 class="mb-4">Change Password</h2>
  <div class="card shadow-sm p-4">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
    <form asp-action="ChangePassword" method="post">
      @Html.AntiForgeryToken()
      <div class="mb-3"><label asp-for="CurrentPassword" class="form-label">Current Password *</label><input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" required></div>
      <div class="mb-3"><label asp-for="NewPassword" class="form-label">New Password *</label><input asp-for="NewPassword" type="password" class="form-control" minlength="6" autocomplete="new-password" required></div>
      <div class="mb-3"><label asp-for="ConfirmNewPassword" class="form-label">Confirm New Password *</label><input asp-for="ConfirmNewPassword" type="password" class="form-control" minlength="6" autocomplete="new-password" required></div>
      <div class="d-flex flex-wrap gap-2"><button type="submit" class="btn btn-save-profile">Change Password</button><a asp-action="Index" class="btn btn-outline-dark">Cancel</a></div>
    </form>
  </div>
</main>
