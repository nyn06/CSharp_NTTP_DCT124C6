<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MetropolitanCoffee.Core\MetropolitanCoffee.Core.csproj" />
    <ProjectReference Include="..\MetropolitanCoffee.Data\MetropolitanCoffee.Data.csproj" />
    <ProjectReference Include="..\MetropolitanCoffee.Services\MetropolitanCoffee.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
